import json
import numpy as np

def export(tas_low, tas_high, path="data.json"):
    def prep(da):
        da = da.squeeze()
        if float(da.mean()) > 200:          # Kelvin -> Celsius
            da = da - 273.15
        return da.groupby("time.year").mean()   # yearly means

    low, high = prep(tas_low), prep(tas_high)

    lat = [d for d in low.dims if "lat" in d][0]
    lon = [d for d in low.dims if "lon" in d][0]
    low = low.transpose("year", lat, lon)
    high = high.transpose("year", lat, lon)
    gap = high - low

    # global gap per year (area-weighted), for the line chart
    w = np.cos(np.deg2rad(gap[lat]))
    glob = gap.weighted(w).mean([lat, lon])

    # 20-year trailing average, then shrink the grid
    def smooth_grid(da):
        s = da.rolling(year=20, min_periods=1).mean()
        return s.coarsen({lat: 6, lon: 6}, boundary="trim").mean()

    s_gap, s_low, s_high = smooth_grid(gap), smooth_grid(low), smooth_grid(high)

    # latitude bands: average gap in each 30-degree band, per year
    edges = [-90, -60, -30, 0, 30, 60, 90]
    vals = s_gap.values                  # (year, lat, lon)
    lats = s_gap[lat].values
    bands = []
    for lo, hi in zip(edges[:-1], edges[1:]):
        m = (lats >= lo) & (lats < hi)
        wt = np.cos(np.deg2rad(lats[m]))
        bands.append((vals[:, m, :].mean(axis=2) * wt).sum(axis=1) / wt.sum())
    bands = np.array(bands).T            # (year, 6)

    def flat(s):
        return [s.isel(year=i).values.round(1).ravel().tolist() for i in range(len(s.year))]

    out = {
        "years": [int(y) for y in gap.year.values],
        "lats": s_gap[lat].values.round(2).tolist(),
        "lons": s_gap[lon].values.round(2).tolist(),
        "gap": flat(s_gap),
        "low": flat(s_low),
        "high": flat(s_high),
        "global": glob.values.round(2).tolist(),
        "bands": bands.round(2).tolist(),
    }
    json.dump(out, open(path, "w"))
    print("wrote", path)

export(tas_low, tas_high)
